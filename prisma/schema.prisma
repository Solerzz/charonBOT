generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum TemporaryRoomStatus {
  CREATING
  ACTIVE
  CLOSING
  CLOSED
}

model VoiceCreator {
  id                      String          @id @default(uuid()) @db.Uuid
  guildDiscordId          String
  creatorChannelDiscordId String          @unique
  categoryDiscordId       String
  roomCommandsEnabled     Boolean         @default(true)
  defaultUserLimit        Int             @default(0)
  deletedAt               DateTime?       @db.Timestamptz(3)
  createdAt               DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @db.Timestamptz(3)
  temporaryRooms          TemporaryRoom[]

  @@index([guildDiscordId])
  @@index([deletedAt])
}

model TemporaryRoom {
  id                      String              @id @default(uuid()) @db.Uuid
  guildDiscordId          String
  voiceCreatorId          String              @db.Uuid
  channelDiscordId        String              @unique
  ownerDiscordId          String?
  controlMessageDiscordId String?
  name                    String
  userLimit               Int                 @default(0)
  visibility              RoomVisibility      @default(PUBLIC)
  status                  TemporaryRoomStatus @default(CREATING)
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(3)
  closedAt                DateTime?           @db.Timestamptz(3)
  controlVersion          Int                 @default(0)
  priorityMemberDiscordId String?
  priorityExpiresAt       DateTime?           @db.Timestamptz(3)
  voiceCreator            VoiceCreator        @relation(fields: [voiceCreatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  presences               RoomPresence[]
  allowedMembers          RoomAllowedMember[]
  pendingTransfer         PendingOwnershipTransfer?

  @@index([guildDiscordId, ownerDiscordId, status])
  @@index([channelDiscordId, status])
}

model RoomPresence {
  id              String        @id @default(uuid()) @db.Uuid
  roomId          String        @db.Uuid
  memberDiscordId String
  isBot           Boolean
  joinedAt        DateTime      @db.Timestamptz(3)
  room            TemporaryRoom @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roomId, memberDiscordId])
}

model RoomAllowedMember {
  id              String        @id @default(uuid()) @db.Uuid
  roomId          String        @db.Uuid
  memberDiscordId String
  room            TemporaryRoom @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roomId, memberDiscordId])
}

model PendingOwnershipTransfer {
  id              String        @id @default(uuid()) @db.Uuid
  roomId          String        @unique @db.Uuid
  ownerDiscordId  String
  targetDiscordId String
  controlVersion  Int
  expiresAt       DateTime?     @db.Timestamptz(3)
  room            TemporaryRoom @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}
